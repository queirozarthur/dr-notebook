# Copie para .env e preencha. O .env não vai para o repositório. No GitHub Pages
# estas variáveis vêm do workflow (.github/workflows/publicar.yml).

# Endereço público da raiz do site, sem barra no fim, com o subcaminho se houver
# (ex.: https://www.exemplo.com.br ou https://usuario.github.io/dr-notebook).
# Usado nas URLs absolutas do Open Graph, do sitemap e dos dados estruturados.
# Sem ele, o build usa http://localhost:3000.
SITE_URL=

# Subcaminho do site, quando ele não fica na raiz do domínio (ex.: /dr-notebook
# no GitHub Pages de projeto). Vazio num domínio próprio.
BASE_PATH=

# "nao" pede aos buscadores para não indexar o site (versão de demonstração).
INDEXAR=
